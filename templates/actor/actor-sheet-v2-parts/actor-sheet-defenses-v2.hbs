<section
  class='tab defenses {{tab.cssClass}}'
  data-group='primary'
  data-tab='defenses'
>

    {{> (getModulePath 'actor/actor-sheet-v2-parts/actor-sheet-search-partial-v2.hbs') this }}

    <section class="item-list-container">
        <div class="item-header">
            <div class="item-column item-description">{{localize "ActorSheet.Description"}}</div>
            <div class="item-column item-end">{{localize "ActorSheet.End"}}</div>
            <div class="item-column item-controls"></div>
        </div>

        <ol class="item-list unlist">
            {{#each items as |entry|}}
                {{#if entry.header}}
                    {{> (getModulePath 'actor/actor-sheet-v2-parts/actor-sheet-group-header-partial-v2.hbs') entry.item }}
                {{else}}
                    {{> (getModulePath 'actor/actor-sheet-v2-parts/actor-sheet-defenses-partial-item-v2.hbs') entry.item }}
                {{/if}}
            {{/each}}
        </ol>
    </section>
</section>